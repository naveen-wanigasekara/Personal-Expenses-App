# Frontend values are PUBLIC. Use the isolated QA project's URL/key locally.
VITE_SUPABASE_URL=https://your-qa-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-qa-publishable-or-anon-key

# Server-only. Never prefix either encryption value with VITE_.
# Generate the master once using node:crypto.randomBytes(32).toString('base64url').
# Back it up securely; changing it without re-encryption makes v2 data unreadable.
ENCRYPTION_MASTER_KEY=replace-with-43-character-base64url-master-key
# Preserve the EXACT historical shared secret for migrating existing enc: data.
# For a new empty database this variable can be omitted.
LEGACY_ENCRYPTION_SECRET=replace-only-when-migrating-legacy-data

# Server URL/key must identify the same isolated project as the frontend values.
SUPABASE_URL=https://your-qa-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-qa-publishable-or-anon-key
PREVIEW_SUPABASE_PROJECT_REF=your-qa-project-ref
PRODUCTION_SUPABASE_PROJECT_REF=your-live-project-ref
