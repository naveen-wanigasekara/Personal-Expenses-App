# Rename this file to .env.local and fill in your credentials.
# Get Supabase values from: https://app.supabase.com → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Encryption secret — used to derive the per-user AES-256 key that encrypts all
# financial data before it is stored in Supabase. Must be set to the SAME value
# across every environment (dev, staging, prod) that shares the same database,
# otherwise encrypted rows become unreadable.
#
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# NEVER commit the real value to source control.
VITE_ENCRYPTION_SECRET=your-random-secret-here
